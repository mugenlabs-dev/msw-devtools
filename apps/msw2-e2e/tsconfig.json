{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": {
      "#msw-version-switch": ["../demo/src/components/msw-version-switch.tsx"]
    }
  },
  "include": ["src", "../demo/src/components/msw-version-switch.tsx"]
}

{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "./node_modules/ultracite/config/biome/core/biome.jsonc",
    "./node_modules/ultracite/config/biome/react/biome.jsonc"
  ],
  "files": {
    "includes": [
      "!!**/routeTree.gen.ts",
      "!!**/mockServiceWorker.js",
      "!!**/storybook-static",
      // Vendored lucide-animated registry components, kept verbatim from upstream
      "!!apps/demo/src/components/icons/*.tsx"
    ]
  },
  "formatter": {
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "correctness": {
        // Biome can't resolve TypeScript path aliases (#/...) or vitest globals
        "noUndeclaredVariables": "off"
      },
      "suspicious": {
        "noDoubleEquals": "off",
        // `x != null` is the project idiom for null-or-undefined checks
        "noEqualsToNull": "off",
        // Misfires on ref.current and other values Biome cannot narrow
        "noUnnecessaryConditions": "off"
      },
      "complexity": {
        "noVoid": "off"
      },
      "performance": {
        // E2E tests and callback patterns use inline regex legitimately
        "useTopLevelRegex": "off",
        // Core package re-exports via index.ts intentionally
        "noBarrelFile": "off",
        // Inline handlers in JSX are fine at this app's scale
        "noJsxPropsBind": "off"
      }
    }
  },
  "overrides": [
    {
      // Playwright tests and Storybook play functions await steps sequentially on purpose
      "includes": ["e2e/**", "**/*.stories.tsx"],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off"
          }
        }
      }
    }
  ]
}

{
  "name": "msw-devtools-monorepo",
  "private": true,
  "scripts": {
    "audit:published": "bash scripts/audit-published.sh",
    "audit:workspace": "pnpm audit --audit-level=moderate",
    "build": "pnpm --filter ./packages/core run build",
    "build-storybook": "pnpm --filter ./packages/core run build-storybook",
    "changeset": "changeset",
    "clean": "pnpm -r run clean",
    "dev": "pnpm --filter ./packages/core run dev",
    "dev:demo": "pnpm --parallel --filter demo --filter msw2-e2e run dev",
    "generate:og": "tsx scripts/generate-og-image.tsx",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:package": "publint --strict packages/core && attw --pack packages/core --profile esm-only",
    "prepare": "node scripts/install-git-hooks.mjs",
    "readme:check": "node scripts/sync-readme.mjs --check",
    "readme:sync": "node scripts/sync-readme.mjs",
    "storybook": "pnpm --filter ./packages/core run storybook",
    "test": "vitest --project=unit",
    "test:ci": "vitest run --project=unit",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:msw2": "playwright test -c playwright.msw2.config.ts",
    "test-storybook": "vitest run --project=storybook",
    "typecheck": "pnpm build && tsgo -p packages/core --noEmit && tsgo -p apps/demo --noEmit && tsgo -p apps/msw2-e2e --noEmit",
    "typecheck:peers:oldest": "bash scripts/typecheck-peers-oldest.sh"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.8",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.65.1",
    "@resvg/resvg-js": "^2.6.2",
    "@storybook/addon-vitest": "^10.6.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/browser": "^5.1.1",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.63.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "ultracite": "^8.3.0",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ],
    "overrides": {
      "brace-expansion": "^5.0.12",
      "seroval": "^1.6.3",
      "source-map-js": "^1.2.2",
      "undici": "^7.29.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  },
  "msw": {
    "workerDirectory": [
      "apps/demo/public",
      "apps/msw2-e2e/public"
    ]
  }
}

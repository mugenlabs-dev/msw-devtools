{
  "name": "@mugenlabs/msw-devtools",
  "version": "0.6.0",
  "description": "A TanStack DevTools plugin for managing MSW (Mock Service Worker) mocks in the browser",
  "keywords": [
    "api-mocking",
    "devtools",
    "mock-service-worker",
    "mocking",
    "msw",
    "react",
    "tanstack"
  ],
  "homepage": "https://github.com/mugenlabs-dev/msw-devtools",
  "bugs": {
    "url": "https://github.com/mugenlabs-dev/msw-devtools/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mugenlabs-dev/msw-devtools.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "Yago Gonzalez",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs"
    },
    "./adapters/urql": {
      "types": "./dist/adapters/urql.d.ts",
      "import": "./dist/adapters/urql.mjs"
    },
    "./adapters/tanstack-query": {
      "types": "./dist/adapters/tanstack-query.d.ts",
      "import": "./dist/adapters/tanstack-query.mjs"
    },
    "./adapters/swr": {
      "types": "./dist/adapters/swr.d.ts",
      "import": "./dist/adapters/swr.mjs"
    },
    "./adapters/apollo": {
      "types": "./dist/adapters/apollo.d.ts",
      "import": "./dist/adapters/apollo.mjs"
    },
    "./adapters/axios": {
      "types": "./dist/adapters/axios.d.ts",
      "import": "./dist/adapters/axios.mjs"
    },
    "./adapters/rtk-query": {
      "types": "./dist/adapters/rtk-query.d.ts",
      "import": "./dist/adapters/rtk-query.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build-storybook": "storybook build",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "storybook": "storybook dev -p 6006",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/pacer": "^0.22.0"
  },
  "devDependencies": {
    "@apollo/client": "^3.14.1",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tanstack/react-devtools": "^0.9.13",
    "@tanstack/react-query": "^5.102.8",
    "@urql/core": "^6.0.3",
    "graphql": "^16.14.2",
    "msw": "^2.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.6.0",
    "swr": "^2.5.1",
    "vite": "^6.4.3",
    "wonka": "^6.3.6",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "@apollo/client": "^3.0.0 || ^4.0.0",
    "@tanstack/react-devtools": ">=0.9.0",
    "@tanstack/react-query": "^5.0.0",
    "@urql/core": "^5.0.0 || ^6.0.0",
    "graphql": "^16.0.0 || ^17.0.0",
    "msw": "^2.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "swr": "^2.0.0",
    "wonka": "^6.0.0",
    "zustand": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@apollo/client": {
      "optional": true
    },
    "@tanstack/react-devtools": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "@urql/core": {
      "optional": true
    },
    "graphql": {
      "optional": true
    },
    "swr": {
      "optional": true
    },
    "wonka": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

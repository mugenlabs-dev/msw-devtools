{
  "name": "@mugenlabs/msw-devtools",
  "version": "0.10.0",
  "description": "A TanStack DevTools plugin for managing MSW (Mock Service Worker) mocks in the browser",
  "keywords": [
    "api-mocking",
    "devtools",
    "mock-service-worker",
    "mocking",
    "msw",
    "react",
    "tanstack"
  ],
  "homepage": "https://msw-devtools.mugenlabs.dev",
  "bugs": {
    "url": "https://github.com/mugenlabs-dev/msw-devtools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mugenlabs-dev/msw-devtools.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "Yago Gonzalez",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs"
    },
    "./adapters/urql": {
      "types": "./dist/adapters/urql.d.ts",
      "import": "./dist/adapters/urql.mjs"
    },
    "./adapters/tanstack-query": {
      "types": "./dist/adapters/tanstack-query.d.ts",
      "import": "./dist/adapters/tanstack-query.mjs"
    },
    "./adapters/swr": {
      "types": "./dist/adapters/swr.d.ts",
      "import": "./dist/adapters/swr.mjs"
    },
    "./adapters/apollo": {
      "types": "./dist/adapters/apollo.d.ts",
      "import": "./dist/adapters/apollo.mjs"
    },
    "./adapters/axios": {
      "types": "./dist/adapters/axios.d.ts",
      "import": "./dist/adapters/axios.mjs"
    },
    "./adapters/rtk-query": {
      "types": "./dist/adapters/rtk-query.d.ts",
      "import": "./dist/adapters/rtk-query.mjs"
    },
    "./persistence": {
      "types": "./dist/persistence.d.ts",
      "import": "./dist/persistence.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build-storybook": "storybook build",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "storybook": "storybook dev -p 6006",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/pacer": "^0.23.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@apollo/client": "^4.3.8",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-query": "^5.108.0",
    "@urql/core": "^6.0.3",
    "graphql": "^17.1.0",
    "msw": "^3.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "swr": "^2.5.1",
    "vite": "^8.3.8",
    "wonka": "^6.3.6"
  },
  "peerDependencies": {
    "@tanstack/react-devtools": "^0.9.0 || ^0.10.0",
    "@tanstack/react-query": "^5.0.0",
    "@urql/core": "^5.0.0 || ^6.0.0",
    "msw": "^2.0.0 || ^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "wonka": "^6.3.2"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-devtools": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "@urql/core": {
      "optional": true
    },
    "wonka": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build && pnpm --filter demo run build",
  "outputDirectory": "apps/demo/dist/client",
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "dest": "/index.md",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/$",
      "headers": {
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "src": "^/index\\.md$",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "src": "^/404\\.md$",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept",
        "X-Robots-Tag": "noindex"
      },
      "continue": true
    },
    {
      "src": "^/openapi\\.json$",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Content-Type": "application/vnd.oai.openapi+json;version=3.1; charset=utf-8",
        "Link": "</.well-known/api-catalog>; rel=\"api-catalog\""
      },
      "continue": true
    },
    {
      "src": "^/\\.well-known/api-catalog$",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Content-Type": "application/linkset+json; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "^/api/v1/site\\.json$",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "public, max-age=300",
        "Content-Type": "application/json; charset=utf-8",
        "Link": "</openapi.json>; rel=\"service-desc\"; type=\"application/vnd.oai.openapi+json\", </.well-known/api-catalog>; rel=\"api-catalog\""
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/api/v1/site/?$",
      "methods": ["GET", "HEAD"],
      "dest": "/api/v1/site.json",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "public, max-age=300",
        "Content-Type": "application/json; charset=utf-8",
        "Link": "</openapi.json>; rel=\"service-desc\"; type=\"application/vnd.oai.openapi+json\", </.well-known/api-catalog>; rel=\"api-catalog\""
      }
    },
    {
      "src": "^/api(?:/.*)?$",
      "dest": "/api/error"
    },
    {
      "src": "^/playground(?:/(?:apollo|fetch|query|rtk-query|swr|urql))?/?$",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "status": 404,
      "dest": "/404.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept",
        "X-Robots-Tag": "noindex"
      }
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
